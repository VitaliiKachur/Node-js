{
  "name": "lab1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "build:static": "set NEXT_OUTPUT=export&& next build",
    "start": "next start",
    "start:static": "npx --yes http-server out -p 8080 -e html",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:check": "node scripts/check-db.mjs",
    "db:dev:push": "set DATABASE_ENV=development&& prisma db push",
    "db:dev:seed": "set DATABASE_ENV=development&& prisma db seed",
    "db:dev:check": "set DATABASE_ENV=development&& node scripts/check-db.mjs",
    "db:prod:push": "set DATABASE_ENV=production&& prisma db push",
    "db:prod:seed": "set DATABASE_ENV=production&& prisma db seed",
    "db:prod:check": "set DATABASE_ENV=production&& node scripts/check-db.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.4",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
